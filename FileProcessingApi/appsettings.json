{
  "ConnectionStrings": {
    "Postgres": "Host=host.docker.internal;Port=5432;Database=FilesDB;Username=postgres;Password=postgres"
  },
  "Storage": {
    "AccountName": "myprocessingfiles",
    "ContainerName": "files"
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "<your-servicebus>.servicebus.windows.net",
    "TopicName": "cps-files-processing-topic",
    "MaxRetries": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
